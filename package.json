{
  "name": "servis-formu-app",
  "version": "1.0.0",
  "description": "Petsis servis formu uygulaması",
  "author": "Batuhan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.petsis.servisformu",
    "productName": "Petsis Servis Formu",
    "compression": "normal",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
 "files": [
      "main.js",
      "preload.js",
      "supabase.js",
      "index.html",
      "assets/**/*",
      "vendor/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "overrides": {
    "node-gyp": "^11.0.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.9"
  }
}
